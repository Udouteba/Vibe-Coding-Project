# 复制为 .env 后填写真实值

# 数据库（MySQL，异步驱动 asyncmy）
DATABASE_URL=mysql+asyncmy://root:123456@127.0.0.1:3306/drainage?charset=utf8mb4

# JWT
JWT_SECRET_KEY=please-change-me-to-a-random-string
JWT_EXPIRE_MINUTES=10080

# LLM（DeepSeek，OpenAI 兼容接口）
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-your-deepseek-key
# DeepSeek 官方模型名为 deepseek-chat / deepseek-reasoner；如服务商提供 flash 型号可填 deepseek-flash
LLM_MODEL_NAME=deepseek-chat
LLM_TEMPERATURE=0.3

# Embedding（本地 BGE 中文模型，首次运行会自动下载约 400MB）
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
# huggingface 镜像端点（国内环境建议 hf-mirror.com，可留空用默认）
HF_ENDPOINT=https://hf-mirror.com
# 模型已缓存时设 1 走离线加载（避免网络抖动卡顿）；首次下载模型需设 0
HF_HUB_OFFLINE=1

# 检索
RETRIEVE_TOP_K=6
RETRIEVE_MIN_SCORE=0.25
RETRIEVE_CACHE_TTL=300
RETRIEVE_CACHE_MAX=512

# 文档切分
CHUNK_SIZE=800
CHUNK_OVERLAP=120
